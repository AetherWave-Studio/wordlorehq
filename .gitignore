# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# wordlore render pipeline — generated audio artifacts
# (regenerated per render; not source-of-truth)
/remotion/assets/audio/voiceover/
/remotion/assets/audio/voiceover.mp3
/remotion/assets/audio/trailer-voiceover/
/remotion/assets/audio/trailer-voiceover.mp3
/remotion/assets/audio/beat-durations.json

# local render output (only used when WORDLORE_OUT_DIR is unset and
# Andrew runs renders outside the cloud routine; renders that should
# land in the repo go to public/episodes/ directly)
/.renders/

# render bookkeeping artifacts (only the .mp4 is the deliverable)
/public/episodes/*-render-props.json
/public/episodes/*-metadata.txt
/public/trailers/*-render-props.json
